{
  "name": "dpdp-cli",
  "version": "0.2.0",
  "private": false,
  "description": "Read-only DPDP compliance scanner CLI for DPDPOS",
  "type": "module",
  "bin": {
    "dpdp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "files": ["dist"]
}
